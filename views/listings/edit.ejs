<!-- //add boiler plate -->
<% layout('/layout/boilerplate') %>
    <div class="row">
        <div class="col-8 offset-2">
            <h3>Edit the Listing</h3>
            <!-- we will use PUT(to update the particular thing) as it is not supported directly use POST itself, add the middleware  -->
            <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">

                <div class="mb-2">
                    <label for="title" class="form-label">Title:</label>
                    <input type="text" id="title" name="title" value="<%= listing.title%>" class="form-control">
                </div>
                <div class="mb-2">
                    <label for="description" class="form-label">Description:</label>
                    <textarea type="text" id="description" name="description"
                        class="form-control"> <%= listing.description %> </textarea>
                </div>
                <div class="mb-2">
                    <label for="image" class="form-label">Image:</label>
                    <input type="text" id="image" name="image" value="<%= listing.image %>" class="form-control">
                </div>
                <div class="mb-2">
                    <label for="price" class="form-label">Price:</label>
                    <input type="number" id="price" name="price" value="<%= listing.price %>" class="form-control">
                </div>
                <div class="mb-2">
                    <label for="location" class="form-label">Location:</label>
                    <input type="text" id="location" name="location" value="<%= listing.location %>"
                        class="form-control">
                </div>
                <div class="mb-2">
                    <label for="country" class="form-label">Country:</label>
                    <input type="text" id="country" name="country" value="<%= listing.country %>" class="form-control">
                </div>
                <button type="submit" class="btn btn-dark mt-3">Submit</button>
            </form>
        </div>
    </div>
    <!-- </body>
</html> -->