<!-- include the nav bar here -->


<% layout('/layout/boilerplate') %>
        <h3>All Listings</h3>
            <div class="row  row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
                <!-- <a href="/listings/new"><button>New Listing</button></a> -->

                <% for(let listing of listings) { %>
                    <!-- <div class="card" style="width: 18rem;"> -->
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <div class="card col show-card">
                            <img src="<%= listing.image %>" class="card-img-top" alt="Listing image will load"
                                style="height:20rem;">
                            <div class="card-body">
                                <p class="card-text">
                                    <b>
                                        <%= listing.title %>
                                    </b><br>
                                    &#8377 <%= listing.price.toLocaleString() %> / night
                                </p>
                            </div>
                        </div>
                    </a>

                    <!-- <li><a href="/listings/<%= listing._id %>"> <%= listing.title %> </a></li> -->
                    <% } %>

            </div>
            <!-- addCDN links for navbar to works from bootstrap -->
