<!-- //add bolier plate -->
<% layout('/layout/boilerplate') %>
    <!-- define row class -->
    <div class="row">
        <!-- make column -->
        <div class="col-8 offset-2">
            <h3>Listing Details</h3>
        </div>
        <div class="card col-6 offset-2 show-card">
            <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing-img">
            <div class="card-body">
                <p class="card-text">
                    <b> <%= listing.title %></b>
                  <br>
                    <strong>Owner:</strong><%= listing.owner.username  %>
                    <br>
                    <%= listing.description %><br>
                    &#8377; <%= listing.price.toLocaleString() %><br>
                    <%= listing.location %><br>
                    <%= listing.country %>
                </p>
            </div>
        </div>
        <div class="col-8 offset-2 ps=4">
            <!-- add edit button, becoz when usr seeing the details of the listing, if he want to edit the details , he can click on edit button -->
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
            <!-- Now add delete button to delet listing -->
            <a href="/listings/<%= listing._id %>?_method=DELETE" class="btn btn-danger">Delete</a>
        </div>

        <div class="col-8 offset-2 mt-5">
            <h4>Leave a review</h4>
            
            <!-- create form for a review -->
            <form action="/listings/<%= listing._id%>/reviews" method="POST" class="need-validation" novalidate>
                <div class="mb-3 mt-3">
                    
                <fieldset class="starability-basic">
                    <legend>First rating:</legend>
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" checked/>
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="20" rows="5" class="form-control"
                        required></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Submit Review</button>
            </form>
            
        </div>

       

        <!-- for showing reviews under particular list -->
       
        <div class="col-8 offset-2 mt-5">
            <hr>
             <h4>All Reviews</h4>
            <div class="row">
                <% for(let review of listing.reviews){ %>
                    <div class="col-sm-6 mb-3 mb-3">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title"><%= review.author.username %></h5>
                                <p class="card-text">
                                    <%= review.comment %>
                                </p>
                                
                                    <p class="starability-result" data-rating="<%= review.rating %>">
                                        Rated: <%= review.rating %>  stars
                                    </p>
                                
                                
                                <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <button type="submit" class="btn btn-danger">Delete Review</button>
                                </form>
                                <!-- <a href="#" class="btn btn-danger">Delete review</a> -->
                            </div>
                        </div>
                    </div>
                    <% } %>
            </div>
        </div>
        <!-- </html> -->

        <!-- reomve from review ,becoz i am using starability(rather than range type)
        <label for="rating" class="form-label">Rating:</label>
        <input type="range" id="rating" name="review[rating]" min="1" max="5" class="form-range"> -->